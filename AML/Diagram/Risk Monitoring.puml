@startuml
left to right direction
skinparam packageStyle rectangle

actor "System Scheduler /\nMonitoring Engine" as System
actor "Compliance Officer" as Compliance

rectangle "Risk Monitoring Module" {
  usecase "Assess Customer Risk" as UC1
  usecase "Assess Transaction Risk" as UC2
  usecase "Apply AML Rules /\nThresholds / Patterns" as UC3
  usecase "Detect Suspicious Activity" as UC4
  usecase "Generate Alert" as UC5
  usecase "Prioritize Alert" as UC6
}

System --> UC1
System --> UC2
System --> UC3
Compliance --> UC6

UC1 .> UC3 : <<include>>
UC2 .> UC3 : <<include>>
UC3 .> UC4 : <<include>>
UC4 .> UC5 : <<include>>
UC5 .> UC6 : <<include>>
@enduml