@startuml
left to right direction
skinparam packageStyle rectangle

actor "Compliance Officer" as Compliance
actor "External Risk Data Sources" as RiskSource

rectangle "List Management Module" {
  usecase "Sync International Lists" as UC1
  usecase "Upload Domestic Lists" as UC2
  usecase "Maintain Watchlists" as UC3
  usecase "Delist / Update Entries" as UC4
  usecase "Validate Uploaded Data" as UC5
}

RiskSource --> UC1
Compliance --> UC2
Compliance --> UC3
Compliance --> UC4

UC2 .> UC5 : <<include>>
UC3 .> UC4 : <<extend>>
@enduml