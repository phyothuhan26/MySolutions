@startuml
left to right direction
skinparam packageStyle rectangle

actor "Compliance Officer" as Compliance
actor "Branch / Ops User" as Ops

rectangle "Administration & Reporting Module" {
  usecase "Manage Users" as UC1
  usecase "Assign Roles / Permissions" as UC2
  usecase "View Dashboard" as UC3
  usecase "View AML Reports" as UC4
  usecase "Export Reports" as UC5
  usecase "View Audit Logs" as UC6
}

Compliance --> UC1
Compliance --> UC2
Compliance --> UC3
Compliance --> UC4
Compliance --> UC5
Compliance --> UC6

Ops --> UC3
Ops --> UC4

UC1 .> UC2 : <<include>>
UC4 .> UC5 : <<extend>>
@enduml